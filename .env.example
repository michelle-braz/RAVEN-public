# Copy to .env for local development. Never commit the real file. See docs/system/configuration.md.

# ── Access ────────────────────────────────────────────────────────────────────
# Operator key: full access, the only key allowed on /ops/metrics and /beta/business-proof.
# Production needs at least 32 characters:  python -c "import secrets; print(secrets.token_urlsafe(48))"
RAVEN_API_KEY=replace-with-a-local-development-key

# Customer keys, comma-separated (production: each at least 24 characters). All optional.
FREE_API_KEYS=
PRO_API_KEYS=
# JSON registry of named keys; generate entries with: python -m raven.admin keys new "Customer"
BETA_KEYS_JSON=

# ── Runtime ───────────────────────────────────────────────────────────────────
# development | production. Production refuses to start with a weak/missing key or CORS "*",
# disables /docs and /openapi.json (unless RAVEN_ENABLE_DOCS=1) and sends HSTS.
ENVIRONMENT=development
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=info
# Explicit browser origins allowed to call the API (comma-separated). Empty = none.
CORS_ORIGINS=http://127.0.0.1:8000
RAVEN_DATA_DIR=data
# RAVEN_ENABLE_DOCS=1
# RAVEN_MAX_BODY_BYTES=262144
# Analyses per minute per client address on /v1/analyze (raise it for server-to-server integrations).
# RAVEN_RATE_LIMIT_PER_MINUTE=30
# Number of reverse proxies in front of the app that append to X-Forwarded-For (0 = none).
RAVEN_TRUSTED_PROXY_HOPS=0

# ── Sentinel pipeline ─────────────────────────────────────────────────────────
SENTINEL_BUFFER_MAXSIZE=256
SENTINEL_BUFFER_POLICY=DROP_NEWEST
SENTINEL_WINDOW_MAXLEN=5000
SENTINEL_WINDOW_TTL=3600
SENTINEL_DEBUG=0
SENTINEL_STRICT_MODE=0
