# Required for protected endpoints. Replace this placeholder locally.
RAVEN_API_KEY=replace-with-a-local-development-key

# Optional comma-separated keys.
FREE_API_KEYS=
PRO_API_KEYS=
BETA_KEYS_JSON=

# Runtime settings.
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=info
ENVIRONMENT=development
CORS_ORIGINS=http://127.0.0.1:8000
RAVEN_DATA_DIR=data

# Sentinel pipeline settings.
SENTINEL_BUFFER_MAXSIZE=1000
SENTINEL_BUFFER_POLICY=DROP_NEWEST
SENTINEL_WINDOW_MAXLEN=5000
SENTINEL_WINDOW_TTL=3600
SENTINEL_WEBHOOK_URL=
SENTINEL_DEBUG=0
SENTINEL_STRICT_MODE=0

