      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    },
    "securitySchemes": {
      "APIKeyHeader": {
        "in": "header",
        "name": "X-API-Key",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "description": "## RAVEN Incident Intelligence API\n\nTwo independent scoring engines are available:\n\n| Endpoint | Engine | Score range | Severity bands |\n|---|---|---|---|\n| `POST /evaluate` | Rule-based (legacy) | Integer **0 – 100** | LOW / MEDIUM / HIGH |\n| `POST /v1/analyze` | Sentinel 4-layer pipeline | Float **0.0 – 1.0** | LOW / MEDIUM / HIGH / CRITICAL |\n\nAll protected endpoints require the `X-API-Key` header.\n\nAll error responses share the envelope `{\"error\": \"...\", \"code\": \"...\"}`.",
    "title": "RAVEN Incident Intelligence API",
    "version": "1.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/beta/business-proof": {
      "get": {
        "operationId": "business_proof_beta_business_proof_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Business Proof Beta Business Proof Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Business validation report — is RAVEN creating real value?",
        "tags": [
          "feedback"
        ]
      }
    },
    "/beta/decision-impact": {
      "post": {
        "description": "Submit after acting on a RAVEN recommendation. Use the `incident_id` and `request_id` from the `/v1/analyze` response.",
        "operationId": "submit_decision_impact_beta_decision_impact_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DecisionImpactRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Submit Decision Impact Beta Decision Impact Post",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Record that RAVEN influenced a real decision",
        "tags": [
          "feedback"
        ]
      }
    },
    "/beta/impact-summary": {
      "get": {
        "operationId": "impact_summary_beta_impact_summary_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Impact Summary Beta Impact Summary Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Aggregated decision impact metrics",
        "tags": [
          "feedback"
        ]
      }
    },
    "/beta/validate-resolution": {
      "post": {
        "description": "Records an analyst's validation of a RAVEN recommendation. Always writes a DecisionImpact record. When `memory_write_approved=true` and `resolution_text` is provided, also creates a ValidatedIncident in long-term memory (`validated_incidents.jsonl`).",
        "operationId": "validate_resolution_beta_validate_resolution_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ValidateResolutionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidateResolutionResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Submit analyst validation and optionally store as incident memory",
        "tags": [
          "feedback"
        ]
      }
    },
    "/evaluate": {
      "post": {
        "description": "Rule-based scoring engine. Returns an **integer** risk score (0 – 100) and a level band.\n\n**Score thresholds:** LOW < 40 · MEDIUM 40–69 · HIGH ≥ 70\n\n**Scoring rules:**\n- `action=login_failed` → +30\n- `attempts ≥ 3` → +40\n- Known suspicious IP → +10\n\nFor pipeline-based multi-factor scoring with float scores (0.0 – 1.0), four severity bands, and recurrence detection, use `POST /v1/analyze`.",
        "operationId": "evaluate_event_evaluate_post",
        "requestBody": {
          "content": {
            "application/json": {
              "examples": {
                "high_risk": {
                  "summary": "High-risk login attempt (score 80, HIGH)",
                  "value": {
                    "action": "login_failed",
                    "attempts": 5,
                    "ip": "192.168.1.1",
                    "message": "failed login from suspicious IP",
                    "source": "application",
                    "user_id": "user_001"
                  }
                },
                "low_risk": {
                  "summary": "Low-risk page view (score 0, LOW)",
                  "value": {
                    "action": "page_view",
                    "attempts": 0,
                    "ip": "8.8.8.8",
                    "message": "user viewed dashboard",
                    "source": "application",
                    "user_id": "user_002"
                  }
                }
              },
              "schema": {
                "properties": {
                  "action": {
                    "description": "Event action (e.g. login_failed, page_view).",
                    "type": "string"
                  },
                  "attempts": {
                    "default": 0,
                    "description": "Number of attempts.",
                    "type": "integer"
                  },
                  "ip": {
                    "description": "Source IP address.",
                    "type": "string"
                  },
                  "message": {
                    "description": "Event description.",
                    "type": "string"
                  },
                  "source": {
                    "default": "unknown",
                    "description": "Signal origin.",
                    "type": "string"
                  },
                  "user_id": {
                    "description": "User identifier.",
                    "type": "string"
                  }
                },
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Evaluate Event Evaluate Post",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          }
        ],
        "summary": "Score an event (rule-based legacy engine)",
        "tags": [
          "evaluate"
        ]
      }
    },
    "/health": {
      "get": {
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Health Health Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Liveness probe",
        "tags": [
          "ops"
        ]
      }
    },
    "/ops/metrics": {
      "get": {
        "description": "In-process counters since start: requests, 4xx/5xx, rate-limited and failed-auth requests, analyses and storage failures, plus pipeline buffer state.",
        "operationId": "ops_metrics_ops_metrics_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
