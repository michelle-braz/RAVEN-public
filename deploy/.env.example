# Copy to deploy/.env and fill in. Never commit the real file.

# Public host name served by the proxy (needs DNS pointing at this machine for HTTPS).
RAVEN_DOMAIN=raven.example.com

# Operator key: full access, including /ops/metrics. Generate:  python -c "import secrets; print(secrets.token_urlsafe(48))"
RAVEN_API_KEY=

# Customer keys (comma-separated, each at least 24 characters). Optional.
PRO_API_KEYS=
FREE_API_KEYS=
BETA_KEYS_JSON=

# Browser origins allowed to call the API. Leave empty for server-to-server use only.
CORS_ORIGINS=

LOG_LEVEL=info
